{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments"
  },
  "response": {
    "status": 202,
    "jsonBody": {
      "paymentId": "pay-compose-{{jsonPath request.body '$.orderId'}}",
      "status": "PENDING"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}
