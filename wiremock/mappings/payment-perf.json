{
  "request": {
    "method": "POST",
    "urlPath": "/payments",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.amount",
          "equalTo": "12345.01"
        }
      }
    ]
  },
  "response": {
    "status": 202,
    "jsonBody": {
      "paymentId": "perf-{{jsonPath request.body '$.orderId'}}",
      "status": "PENDING"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  },
  "priority": 1
}
