{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments",
    "bodyPatterns": [{"matchesJsonPath": {"expression": "$.amount", "matches": "500(\\.0+)?"}}]
  },
  "response": {
    "status": 500,
    "jsonBody": {"errorCode": "PAYMENT_INTERNAL_ERROR", "errorMessage": "Payment provider failed internally"},
    "headers": {"Content-Type": "application/json"}
  }
}
