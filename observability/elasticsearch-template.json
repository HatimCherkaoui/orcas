{
  "index_patterns": [
    "traces-orcas-*",
    "logs-orcas-*",
    "metrics-orcas-*"
  ],
  "priority": 500,
  "data_stream": {},
  "template": {
    "settings": {
      "index.default_pipeline": "orcas-correlation",
      "number_of_replicas": 0,
      "refresh_interval": "10s"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "identifier_extensions": {
            "match": "*Id",
            "mapping": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        {
          "strings": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        {
          "histograms": {
            "match_mapping_type": "object",
            "match": "*.duration",
            "mapping": {
              "type": "histogram"
            }
          }
        }
      ],
      "properties": {
        "requestId": {
          "type": "keyword",
          "ignore_above": 256
        },
        "correlationId": {
          "type": "keyword",
          "ignore_above": 256
        },
        "transactionId": {
          "type": "keyword",
          "ignore_above": 256
        },
        "traceId": {
          "type": "keyword",
          "ignore_above": 256
        },
        "workflowId": {
          "type": "keyword",
          "ignore_above": 256
        },
        "workflow": {
          "type": "keyword",
          "ignore_above": 256
        },
        "workflowStep": {
          "type": "keyword",
          "ignore_above": 256
        },
        "eventType": {
          "type": "keyword",
          "ignore_above": 256
        },
        "relatedEventType": {
          "type": "keyword",
          "ignore_above": 256
        },
        "outcome": {
          "type": "keyword",
          "ignore_above": 256
        },
        "serviceName": {
          "type": "keyword",
          "ignore_above": 256
        },
        "@timestamp": {
          "type": "date_nanos"
        },
        "durationMs": {
          "type": "double"
        },
        "Attributes": {
          "type": "object",
          "enabled": false
        },
        "attributes": {
          "type": "object",
          "enabled": false
        },
        "Resource": {
          "type": "object",
          "enabled": false
        },
        "resource": {
          "type": "object",
          "enabled": false
        },
        "Scope": {
          "type": "object",
          "enabled": false
        },
        "Link": {
          "type": "object",
          "enabled": false
        },
        "Event": {
          "type": "object",
          "enabled": false
        },
        "TraceId": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "httpStatusCode": {
          "type": "long"
        },
        "dbOperation": {
          "type": "keyword"
        },
        "exceptionType": {
          "type": "keyword"
        },
        "exceptionMessage": {
          "type": "text"
        },
        "status": {
          "type": "keyword"
        }
      }
    }
  }
}
